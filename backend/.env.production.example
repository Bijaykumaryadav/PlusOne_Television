# Backend Production Environment Template
# Copy this to backend/.env and fill in your production values

# Database Configuration
MONGO_URL=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Authentication & Security
JWT_SECRET_KEY=generate_a_strong_random_string_here
SESSION_SECRET=generate_another_random_string_here

# Google OAuth (get from Google Cloud Console)
CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret_here

# Email Configuration (Gmail)
Email=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# Frontend URL (Production)
FRONTEND_URL=https://sidhareporting.com

# Server Configuration
PORT=8000
NODE_ENV=production

# Cloudinary Configuration (Image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Khalti Payment Gateway (Production Keys)
KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_PRODUCT_URL=https://sidhareporting.com

# eSewa Payment Gateway (Production Keys)
ESEWA_MERCHANT_CODE=your_merchant_code
ESEWA_SECRET_KEY=your_secret_key
ESEWA_SUCCESS_URL=https://sidhareporting.com/apis/v1/payments/esewa/success
ESEWA_FAILURE_URL=https://sidhareporting.com/apis/v1/payments/esewa/failure
