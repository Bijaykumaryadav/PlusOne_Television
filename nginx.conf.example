# Nginx Configuration for sidhareporting.com
# Place this in: /etc/nginx/sites-available/sidhareporting.com
# Then enable with: sudo ln -s /etc/nginx/sites-available/sidhareporting.com /etc/nginx/sites-enabled/

server {
    server_name sidhareporting.com www.sidhareporting.com;

    # Redirect HTTP to HTTPS (after SSL is installed)
    if ($scheme != "https") {
        return 301 https://$server_name$request_uri;
    }

    # Frontend - React Application
    location / {
        proxy_pass http://localhost:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Backend API Routes
    location /apis/ {
        proxy_pass http://localhost:8000/apis/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # CORS headers (if needed)
        add_header 'Access-Control-Allow-Origin' '$http_origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }
    }

    # SSL Certificate (will be added by Certbot)
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/sidhareporting.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sidhareporting.com/privkey.pem;

    # SSL Configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name sidhareporting.com www.sidhareporting.com;
    return 301 https://$server_name$request_uri;
}
