# Frontend Production Environment Variables
# This file is used during production build on Hostinger

# API Base URL - Points to your backend API
# Option 1: If backend is on same domain
VITE_API_URL=https://sidhareporting.com/apis/v1/

# Option 2: If backend is on subdomain
# VITE_API_URL=https://api.sidhareporting.com/apis/v1/

# Other environment variables for Vite build
VITE_APP_TITLE=PlusOne Television
